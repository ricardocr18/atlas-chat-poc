# Arquivo exemplo para ENV local de desenvolvimento.
# Para utilizar, renomeie este arquivo para ".env" e preencha os valores
# conforme o seu ambiente local (Windows + MongoDB Compass + pgAdmin).
#
# Nota: no ambiente real da Sicredi, estes valores virao do Vault/Consul,
# via biblioteca engineering_commons, e nao de um .env. Este arquivo existe
# só para o ambiente local mockado.

COMPONENT_NAME=atlas-classificacao-agent

# ---------------------------------------------------------------------------
# MongoDB — mesmo servidor usado pelo atlas-documentacao-agent no seu
# ambiente local (ex: localhost:27017), mas com DUAS databases logicas:
#   - MONGO_DB_DOCUMENTACAO: database do atlas-documentacao-agent (LEITURA)
#   - MONGO_DB_CLASSIFICACAO: database propria deste agente (ESCRITA)
# ---------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_DOCUMENTACAO=atlas_documentacao_agente
MONGO_DB_CLASSIFICACAO=atlas_classificacao_agente

# ---------------------------------------------------------------------------
# PostgreSQL — mesmo banco compartilhado com o atlas-documentacao-agent.
# Este agente LE (descoberta de pendencias) e ESCREVE (atualizacao de
# status_cadastro) na mesma tabela objetos_gerados_previas.
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas_documentacao_agente
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
